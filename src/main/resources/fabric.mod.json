{
	"schemaVersion": 1,
	"id": "lth",
	"version": "${version}",
	"name": "LT-Hearts",
	"description": "LT-Hearts adds clear heart bars above players heads and optional damage animations, allowing you to quickly assess the state of a PvP fight.",
	"authors": [
		"LordTricker"
	],
	"contact": {
		"homepage": "https://blazecode.pl/",
		"sources": "https://github.com/LordTricker"
	},
	"license": "MIT",
	"icon": "assets/lth/icon.png",

	"environment": "*",
	"entrypoints": {
        "main": [
                "pl.lordtricker.lth.ModTemplate"
        ],
        "client": [
          "pl.lordtricker.lth.client.LTHeartsClient"
        ]
},
	"mixins": [
		{
			"config": "lth.client.mixins.json",
			"environment": "client"
		}
	],

	"depends": {
      "fabricloader": ">=0.17.12",
      "minecraft": ">=1.21.9 <=1.21.10",
      "java": ">=21",
      "fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
